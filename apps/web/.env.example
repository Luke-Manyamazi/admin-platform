# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# URL of this app — required for OAuth redirect / cookie domain
AUTH_URL=http://localhost:3000
# Secret used to sign/encrypt session JWTs — generate with: openssl rand -hex 32
AUTH_SECRET=change-me-in-development

# ─── API Gateway ─────────────────────────────────────────────────────────────
# Base URL for the ADMIN API gateway (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── Feature flags ───────────────────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js (development | production | test)
