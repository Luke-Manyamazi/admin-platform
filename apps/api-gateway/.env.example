# ─── API Gateway Environment Variables ───────────────────────────────────────
# Copy to .env for local development. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
# Gateway uses the shared DB only for auth (user table)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admin_platform_dev

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Downstream service URLs ───────────────────────────────────────────────────
FACTORY_SERVICE_URL=http://localhost:3010
ORDERS_SERVICE_URL=http://localhost:3011
NOTIFICATIONS_SERVICE_URL=http://localhost:3012
PAYMENTS_SERVICE_URL=http://localhost:3013

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
