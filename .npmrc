# ─── pnpm workspace configuration ─────────────────────────────────────────────
# Hoist dev tooling to root node_modules so every workspace can use them
# without explicitly declaring them as dependencies.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=typescript
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=tsx
public-hoist-pattern[]=rimraf
public-hoist-pattern[]=@typescript-eslint*
public-hoist-pattern[]=typescript-eslint
