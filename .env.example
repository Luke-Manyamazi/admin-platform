# ============================================================
# ADMIN Platform — Environment Variables Reference
# Camluk Technologies (South Africa)
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# All monetary values are in CENTS (integer). Never use floats.
# ============================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=ADMIN

# ─── Database (AWS RDS PostgreSQL) ───────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://admin_user:changeme@localhost:5432/admin_platform?schema=public

# ─── Cache (AWS ElastiCache Redis) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AWS Core ────────────────────────────────────────────────────────────────
# Region: af-south-1 (Cape Town) is preferred for African workloads
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ─── AWS S3 (Document & Asset Storage) ───────────────────────────────────────
AWS_S3_BUCKET_NAME=admin-platform-documents-dev

# ─── AWS SES (Transactional Email) ───────────────────────────────────────────
# Must be a verified sender identity in SES
AWS_SES_FROM_EMAIL=noreply@admin-platform.africa

# ─── AWS EventBridge (Event Bus) ─────────────────────────────────────────────
AWS_EVENTBRIDGE_BUS_NAME=admin-platform-events

# ─── Authentication (JWT) ────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_min_32_char_random_secret_never_commit
JWT_EXPIRES_IN=7d

# ─── Payments: Peach Payments ────────────────────────────────────────────────
# South African payment gateway — https://www.peachpayments.com
PEACH_PAYMENTS_MERCHANT_ID=your_merchant_id
PEACH_PAYMENTS_SECRET=your_merchant_secret

# ─── Payments: Flutterwave ───────────────────────────────────────────────────
# Pan-African payment gateway — https://flutterwave.com
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# ─── AI: Cassava Technologies ────────────────────────────────────────────────
# Factory matching and order distribution AI engine
# Mock service used in development — replace with real endpoint in production
CASSAVA_AI_API_KEY=your_cassava_api_key
CASSAVA_AI_BASE_URL=https://api.cassava.ai/v1

# ─── Business Logic ──────────────────────────────────────────────────────────
# Platform commission on every order. Stored in config — NEVER hardcoded.
COMMISSION_RATE_PERCENT=8

# ─── Frontend (Next.js public vars) ──────────────────────────────────────────
# These are exposed to the browser — do NOT put secrets here
NEXT_PUBLIC_API_URL=http://localhost:3001
