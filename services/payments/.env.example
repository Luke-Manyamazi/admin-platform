# ─── Payments Service Environment Variables ──────────────────────────────────
# Copy to .env for local development. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3013

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admin_platform_dev

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must match the secret used by the auth service to sign JWTs
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=af-south-1
AWS_EVENTBRIDGE_BUS_NAME=admin-platform-events
# Leave blank in dev — AWS SDK will use instance profile / env creds in prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Camluk Commission ─────────────────────────────────────────────────────────
# Commission percentage taken by Camluk (integer, e.g. 8 = 8%)
COMMISSION_RATE_PERCENT=8

# ── Peach Payments ────────────────────────────────────────────────────────────
# https://developer.peachpayments.com
PEACH_ENTITY_ID=
PEACH_ACCESS_TOKEN=
# Secret used to validate incoming webhook HMAC signatures
PEACH_WEBHOOK_SECRET=dev-peach-webhook-secret
# Checkout base URL (sandbox vs production)
PEACH_API_BASE_URL=https://testsecure.peachpayments.com

# ── Flutterwave ───────────────────────────────────────────────────────────────
# https://developer.flutterwave.com
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Sent in the verif-hash header on every Flutterwave webhook
FLUTTERWAVE_WEBHOOK_HASH=dev-flutterwave-webhook-hash
FLUTTERWAVE_API_BASE_URL=https://api.flutterwave.com/v3

# ── Internal event secret ─────────────────────────────────────────────────────
# Shared secret for EventBridge-to-HTTP internal webhooks.
# API Gateway passes this in X-Internal-Secret on internal routes.
INTERNAL_WEBHOOK_SECRET=dev-internal-secret-change-in-prod
