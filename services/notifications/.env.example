# ─── Notifications Service Environment Variables ──────────────────────────────
# Copy to .env for local development. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3012

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admin_platform_dev

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AWS SES ───────────────────────────────────────────────────────────────────
# Verified sender identity in SES (must be verified in your AWS account)
SES_FROM_ADDRESS=noreply@admin-platform.camluk.com
SES_FROM_NAME=ADMIN Platform
# Set to true to skip actual SES calls in development
SES_DRY_RUN=true

# ── Internal event secret ─────────────────────────────────────────────────────
# Shared secret for EventBridge-to-HTTP internal webhooks.
INTERNAL_WEBHOOK_SECRET=dev-internal-secret-change-in-prod

# ── Platform URLs (used in email links) ──────────────────────────────────────
BUYER_PORTAL_URL=http://localhost:3000
FACTORY_PORTAL_URL=http://localhost:3000/factory
