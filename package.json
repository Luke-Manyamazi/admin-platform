{
  "name": "admin-platform",
  "version": "0.0.1",
  "private": true,
  "description": "ADMIN — African Distributed Manufacturing & Industrial Network by Camluk Technologies",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml}\" --ignore-path .gitignore",
    "db:generate": "turbo run db:generate --filter=@admin-platform/database",
    "db:migrate": "turbo run db:migrate --filter=@admin-platform/database",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@admin-platform/database",
    "db:studio": "cd packages/database && pnpm exec prisma studio",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.3.0"
}
