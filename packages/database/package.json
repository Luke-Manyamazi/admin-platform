{
  "name": "@admin-platform/database",
  "version": "0.0.1",
  "private": true,
  "description": "ADMIN Database — Prisma schema, migrations, and generated client (PostgreSQL / AWS RDS)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "prisma migrate reset",
    "lint": "echo 'No lint for database package'",
    "type-check": "tsc --noEmit",
    "clean": "rimraf src/generated node_modules/.prisma"
  },
  "dependencies": {
    "@admin-platform/types": "workspace:*",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@admin-platform/config": "workspace:*",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0"
  }
}
