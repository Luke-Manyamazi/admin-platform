{
  "name": "@admin-platform/types",
  "version": "0.0.1",
  "private": true,
  "description": "ADMIN Types — Shared TypeScript interfaces, enums, and DTOs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@admin-platform/config": "workspace:*"
  }
}
