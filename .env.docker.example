# =============================================================================
# ADMIN Platform — Docker Compose environment template
#
# Usage:
#   cp .env.docker.example .env
#   # edit .env and fill in every value marked REQUIRED
#   docker compose up --build
#
# This file is safe to commit — it contains no real secrets.
# .env is git-ignored and must never be committed.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — Postgres container password
POSTGRES_PASSWORD=

# ── Cache ─────────────────────────────────────────────────────────────────────
# REQUIRED — Redis auth password
REDIS_PASSWORD=

# ── JWT (shared across all NestJS services + API Gateway) ─────────────────────
# REQUIRED — min 64 hex chars
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── NextAuth session secret (web + admin apps) ────────────────────────────────
# REQUIRED — min 32 hex chars
# Generate: openssl rand -hex 32
AUTH_SECRET=

# ── Internal webhook secret (EventBridge → HTTP routes) ──────────────────────
# REQUIRED — shared by api-gateway, payments, notifications
# Generate: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=

# ── AWS (leave blank for local dev — services degrade gracefully) ─────────────
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_EVENTBRIDGE_BUS_NAME=admin-platform-events

# ── Notifications / SES ───────────────────────────────────────────────────────
SES_FROM_ADDRESS=noreply@admin-platform.camluk.com
SES_FROM_NAME=ADMIN Platform
# Keep true until SES credentials are configured
SES_DRY_RUN=true
BUYER_PORTAL_URL=http://localhost:3000
FACTORY_PORTAL_URL=http://localhost:3000/factory

# ── Payments: Peach Payments ──────────────────────────────────────────────────
PEACH_ENTITY_ID=
PEACH_ACCESS_TOKEN=
# REQUIRED — used to validate incoming webhook HMAC signatures
PEACH_WEBHOOK_SECRET=
PEACH_API_BASE_URL=https://testsecure.peachpayments.com

# ── Payments: Flutterwave ─────────────────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# REQUIRED — sent in verif-hash header on every Flutterwave webhook
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_API_BASE_URL=https://api.flutterwave.com/v3

# ── Business logic ────────────────────────────────────────────────────────────
COMMISSION_RATE_PERCENT=8

# ── API Gateway tuning ────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ── Next.js public API URL (baked in at image build time) ─────────────────────
# Change to your real domain when building for production
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Auth redirect URLs ────────────────────────────────────────────────────────
WEB_AUTH_URL=http://localhost:3000
ADMIN_AUTH_URL=http://localhost:3002
